{
  "name": "photocollectionviewer",
  "version": "1.0.0",
  "description": "PhotoCollectionViewer - 画像フォルダを管理・表示するデスクトップアプリ",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build": "electron-vite build && electron-builder --win --publish=never",
    "build:vite": "electron-vite build"
  },
  "keywords": [
    "electron",
    "image-viewer",
    "photo"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.masterlink.photocollectionviewer",
    "productName": "PhotoCollectionViewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  }
}
