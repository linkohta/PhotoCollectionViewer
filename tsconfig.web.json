{
  "include": ["src/renderer/src/**/*", "src/renderer/src/**/*.tsx", "src/preload/**/*"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
